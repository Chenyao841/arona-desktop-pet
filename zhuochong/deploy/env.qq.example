# ============================================================
# 阿罗娜 · QQ 机器人敏感值模板
#
# 放哪里：/root/zc-secrets/env.qq（**仓库外**，权限 600）
#   mkdir -p /root/zc-secrets && chmod 700 /root/zc-secrets
#   cp /root/arona/zhuochong/deploy/env.qq.example /root/zc-secrets/env.qq
#   chmod 600 /root/zc-secrets/env.qq
#
# 填写规则：
#   - 等号两边不能有空格，值不要加引号（值里有空格或 # 才需要引号）
#   - 只改等号右边；注释行（# 开头）可以留也可以删
#   - **必须填**的只有 3 个：ZC_DB_PASSWORD、ZC_QQ_WS_TOKEN、ZC_QQ_ADMIN_QQ
#
# 填完自检：bash /root/arona/zhuochong/deploy/preflight.sh
# ============================================================

# ---------- 数据库（云端 MySQL 8 容器 zc-mysql，只监听 127.0.0.1）----------
ZC_DB_HOST=127.0.0.1
ZC_DB_PORT=3306
ZC_DB_NAME=db03
ZC_DB_USER=root
# 【必填】MySQL root 密码。忘了就这样查（在服务器上）：
#   cat ~/notes.txt | grep -i mysql
#   或者试：docker exec -e MYSQL_PWD='候选密码' zc-mysql mysql -uroot -e 'select 1' 
ZC_DB_PASSWORD=

# ---------- NapCat / OneBot 11 正向 WebSocket ----------
# NapCat WebUI（http://服务器IP:6099）→ 网络配置 → 正向 WebSocket 服务器
ZC_QQ_ENABLED=true
# NapCat 里那条 WS 的端口（文档里是 3001，host 必须是 0.0.0.0）
ZC_QQ_WS_URL=ws://127.0.0.1:3001
# 【必填】NapCat 里配的 token（没配就留空）。查当前值：
#   cat /root/napcat/config/onebot11_*.json | grep -A3 websocketServers
#   容器内路径则：docker exec napcat sh -c 'cat /app/napcat/config/onebot11_*.json'
# 填错的表现：日志出现 401/握手失败，/qq/status 一直 connected:false
ZC_QQ_WS_TOKEN=
# 机器人自己的 QQ 号；留 0 = 连上后自动 get_login_info 识别（推荐留 0）
ZC_QQ_SELF_ID=0
# at = 只响应 @ 自己（推荐）；all = 全量消息（烧 token + 封号风险）
ZC_QQ_TRIGGER_MODE=at
# 同一人在同一群的最短响应间隔（秒）；0 = 关闭冷却
ZC_QQ_USER_COOLDOWN=60
# 逗号分隔的群号白名单；留空 = 不限制（建议先填测试群号更安全）
ZC_QQ_GROUP_WHITELIST=

# ---------- P1：表情包 / 看图 ----------
ZC_QQ_EMOJI=true
# 表情包间隔：中间至少隔几条回复才允许再发一张（默认 5；0 = 不限间隔）
ZC_QQ_EMOJI_GAP=5
# 哪些情绪算「情绪变化较大」，不在集合里的情绪不发表情
ZC_QQ_EMOJI_STRONG=激动,害羞,生气,慌张,难过,开心,震惊,俏皮
ZC_QQ_VISION=true
# 【可选】视觉模型名：必须指向真正支持 image_url 输入的模型（api.deepseek.com/v1/models 里看 input_modalities 含 image）
# 当前网关可用：deepseek-flash（多模态）。不填则默认 deepseek-v4-flash-vision-exp
ZC_AI_VISION_MODEL=deepseek-flash

# ---------- P3：管理员 / 记忆隔离 / 额度 ----------
# 【必填】管理员 QQ（逗号分隔可多个）：只有这些人能私聊机器人、能用 /status /groups /usage 等管理指令
# 例：ZC_QQ_ADMIN_QQ=123456789 或 ZC_QQ_ADMIN_QQ=123456789,987654321
ZC_QQ_ADMIN_QQ=
# 私聊只接待管理员（保持 true）
ZC_QQ_ADMIN_ONLY_PRIVATE=true
# 记忆隔离：group（每群一份，推荐）/ user（每群每人一份）/ off（与桌宠共用）
ZC_QQ_MEMORY_SCOPE=group
# 每 N 条群消息后台提炼一次长期记忆（0 = 不自动提炼）
ZC_QQ_MEMORY_EVERY=20
# 每日 token 上限（0 = 不限；只统计 QQ 群 + 管理员私聊，不含桌宠端）
ZC_QQ_DAILY_TOKENS=0
# 用到额度百分之多少就私聊提醒管理员（0=不提醒；用满 100% 必提醒一次）
ZC_QQ_QUOTA_ALERT=80

# ---------- P4：回复节奏 / 恶意@防护 / 引用回复 ----------
# 收到 @ 后至少等几秒再回（想得快也不提前说；0 = 立刻回）
ZC_QQ_REPLY_DELAY=3
# 延迟窗口内同一人连续 @ 到这个次数就拉黑（只有管理员能 /unban）
ZC_QQ_BLACKLIST_BURST=4
# 引用回复（回复带"回复 XX：…"引用框）
ZC_QQ_QUOTE=true
# 额度用尽时对被 @ 的固定说明
ZC_QQ_QUOTA_REPLY=今天我说话太多啦，额度用完了……管理员充值后我就回来～
# 同时允许几条消息在"思考"（调模型）
ZC_QQ_AI_THREADS=4

# ---------- 备份脚本用（deploy/backup-mysql.sh）----------
ZC_BACKUP_DIR=/root/backup
ZC_BACKUP_KEEP_DAYS=7
ZC_MYSQL_CONTAINER=zc-mysql

# ---------- 模型 Key ----------
# 注意：DeepSeek/视觉模型的 Key 存在 MySQL 的 ai_config 表里（管理页「基础设置」填写），
# 不在这里配。库里 api_key 为空时机器人只会回兜底文案。
