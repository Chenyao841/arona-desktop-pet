# 阿罗娜 · QQ 机器人敏感值模板
#
# 用法：复制到云端 /root/arona/.env.qq，填好值，然后 chmod 600
#   cp deploy/env.qq.example /root/arona/.env.qq
#   vi /root/arona/.env.qq && chmod 600 /root/arona/.env.qq
#
# 注意：本文件（.env.qq）绝对不要提交到仓库；仓库里只留这份 example。

# ---------- 数据库（云端 MySQL 8 容器，只监听 127.0.0.1）----------
ZC_DB_HOST=127.0.0.1
ZC_DB_PORT=3306
ZC_DB_NAME=db03
ZC_DB_USER=root
ZC_DB_PASSWORD=

# ---------- NapCat / OneBot 11 正向 WebSocket ----------
# NapCat WebUI 里"网络配置 → 正向 WebSocket 服务器"的端口与 token
ZC_QQ_ENABLED=true
ZC_QQ_WS_URL=ws://127.0.0.1:3001
ZC_QQ_WS_TOKEN=
# 机器人自己的 QQ 号；留 0 则连上后用 get_login_info 自动识别
ZC_QQ_SELF_ID=0
# at = 只响应 @ 自己；all = 全量消息（烧 token + 封号风险，不建议）
ZC_QQ_TRIGGER_MODE=at
ZC_QQ_USER_COOLDOWN=60
# 逗号分隔的群号白名单；留空 = 不限制
ZC_QQ_GROUP_WHITELIST=

# ---------- P1：表情包 / 看图 ----------
ZC_QQ_EMOJI=true
# 表情包间隔：中间至少隔几条回复才允许再发一张（默认 5；0 = 不限间隔）
ZC_QQ_EMOJI_GAP=5
# 哪些情绪算「情绪变化较大」，不在集合里的情绪不发表情
ZC_QQ_EMOJI_STRONG=激动,害羞,生气,慌张,难过,开心,震惊,俏皮
ZC_QQ_VISION=true

# ---------- P3：管理员 / 记忆隔离 / 额度 ----------
# 管理员 QQ（逗号分隔）：只有这些人能私聊机器人、能用 /status /groups /usage 等管理指令
ZC_QQ_ADMIN_QQ=
# 私聊只接待管理员（保持 true）
ZC_QQ_ADMIN_ONLY_PRIVATE=true
# 记忆隔离：group（每群一份，推荐）/ user（每群每人一份）/ off（与桌宠共用）
ZC_QQ_MEMORY_SCOPE=group
# 每 N 条群消息后台提炼一次长期记忆（0 = 不自动提炼）
ZC_QQ_MEMORY_EVERY=20
# 每日 token 上限（0 = 不限；只统计 QQ 群，不含桌宠端）
ZC_QQ_DAILY_TOKENS=0
# MySQL 备份脚本用（deploy/backup-mysql.sh）
ZC_BACKUP_DIR=/root/backup
ZC_BACKUP_KEEP_DAYS=7
ZC_MYSQL_CONTAINER=zc-mysql

# ---------- P4：回复节奏 / 恶意@防护 / 引用回复 ----------
# 收到 @ 后至少等几秒再回（想得快也不提前说；0 = 立刻回）
ZC_QQ_REPLY_DELAY=3
# 延迟窗口内同一人连续 @ 到这个次数就拉黑（只有管理员能 /unban）
ZC_QQ_BLACKLIST_BURST=4
# 引用回复（回复带"回复 XX：…"引用框）
ZC_QQ_QUOTE=true
# 额度用尽时对被 @ 的固定说明
ZC_QQ_QUOTA_REPLY=今天我说话太多啦，额度用完了……管理员充值后我就回来～
# 同时允许几条消息在"思考"（调模型）
ZC_QQ_AI_THREADS=4

# ---------- DeepSeek（如果不想用库里 ai_config 的 Key，可在这里覆盖数据库前先导入）----------
# 注意：模型 Key 目前存在 MySQL 的 ai_config 表里（基础设置页填写），不在这里配
